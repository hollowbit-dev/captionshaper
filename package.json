{
  "name": "captionshaper",
  "version": "1.1.0",
  "main": "src/main.js",
  "productName": "Captionshaper",
  "description": "Captionshaper by Hollowbit: free, offline auto-subtitles. Drop in a video, fix the words, export SRT or burn in TikTok-style captions. Nothing is uploaded.",
  "author": "Elvis Zygmanta",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.mjs && node test/e2e.mjs",
    "test:engine": "node test/engine.test.mjs",
    "accuracy": "node test/accuracy.mjs",
    "bundle-whisper": "bash scripts/bundle-whisper-mac.sh",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "fetch-win": "bash scripts/fetch-whisper-win.sh",
    "site": "node site/build.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "1.48"
  },
  "build": {
    "appId": "dev.hollowbit.captionshaper",
    "productName": "Captionshaper",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/fonts/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "Captionshaper-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "vendor/whisper/darwin-${arch}",
          "to": "whisper"
        },
        {
          "from": "vendor/models/ggml-silero-v5.1.2.bin",
          "to": "models/ggml-silero-v5.1.2.bin"
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm"
          ],
          "name": "Video file",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        },
        {
          "from": "vendor/whisper/win32-x64",
          "to": "whisper"
        },
        {
          "from": "vendor/models/ggml-silero-v5.1.2.bin",
          "to": "models/ggml-silero-v5.1.2.bin"
        },
        {
          "from": "vendor/redist/vc_redist.x64.exe",
          "to": "redist/vc_redist.x64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Captionshaper-Setup-${version}-win-x64.exe",
      "include": "installer/installer.nsh"
    },
    "afterPack": "scripts/after-pack.js",
    "copyright": "\u00a9 2026 Hollowbit \u00b7 Elvis Zygmanta",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hollowbit-dev/captionshaper.git"
  },
  "homepage": "https://hollowbit-dev.github.io/captionshaper/"
}
